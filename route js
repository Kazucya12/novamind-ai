import { handle } from '../../lib/proxy.js';
import { authEmail } from '../../lib/quota.js';

export const GET = (req) => {
  if (!authEmail(req)) {
    return new Response(JSON.stringify({ error: { message: 'Sesi berakhir, silakan masuk lagi' } }), { status: 401, headers: { 'Content-Type': 'application/json' } });
  }
  return handle(req, 'models');
};
export const OPTIONS = (req) => handle(req, 'models');
